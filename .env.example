# URL do cofre no Azure Key Vault
KEY_VAULT_URL=https://nome-do-seu-cofre.vault.azure.net/

# Credenciais para autenticar o middleware no Key Vault
# Em produção via NSSM, configure estas variáveis na aba "Environment" — não use .env
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

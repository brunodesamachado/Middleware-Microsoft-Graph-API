# ──────────────────────────────────────────────────────────────────────────────
# Azure Key Vault (produção)
# Deixe KEY_VAULT_URL em branco para rodar sem Key Vault (modo dev local)
# ──────────────────────────────────────────────────────────────────────────────
KEY_VAULT_URL=https://nome-do-seu-cofre.vault.azure.net/

# Credenciais para autenticar o middleware no Key Vault (produção via NSSM)
# Em dev local use 'az login' — não é necessário preencher estas três variáveis
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────────────────────
# Segredos da aplicação (modo dev local — usados quando KEY_VAULT_URL está vazio)
# Em produção estes valores ficam no Key Vault, não no .env
# ──────────────────────────────────────────────────────────────────────────────
API_KEY_MIDDLEWARE=minha-chave-local-de-desenvolvimento

TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID_SHAREPOINT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET_SHAREPOINT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_ID_EMAIL=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET_EMAIL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
